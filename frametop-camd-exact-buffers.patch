  * share one 32-buffer run, bound to only one of them, so a camera without its
  * own run also gets runs bound to cameras of the same model.
  */
+/*
+ * Which buffer holds a V4L2 index right now. XRService doesn't always queue an index with
+ * the same buffer, so a map learned once goes wrong; guessing the fresh one afterwards can
+ * pick a buffer holding an older frame (side cameras' frames came out 0-250 ms older than
+ * their time stamps, at random). vb2 tells any handle which descriptor the owner last
+ * queued an index with, so ask at every frame, while the index is still dequeued.
+ */
+static void open_node(cam_t *c, const char *path)
+{
+    c->vfd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (c->vfd < 0)
+        return;
+
+    static const uint32_t types[] = { V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, V4L2_BUF_TYPE_VIDEO_CAPTURE };
+
+    for (int i = 0; i < 2; i++) {
+        struct v4l2_buffer b;
+        struct v4l2_plane  planes[VIDEO_MAX_PLANES];
+        memset(&b, 0, sizeof(b));
+        memset(planes, 0, sizeof(planes));
+        b.type = types[i];
+        if (types[i] == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+            b.m.planes = planes;
+            b.length   = VIDEO_MAX_PLANES;
+        }
+        if (ioctl(c->vfd, VIDIOC_QUERYBUF, &b) == 0 && b.memory == V4L2_MEMORY_DMABUF) {
+            c->vtype = types[i];
+            return;
+        }
+    }
+
+    close(c->vfd);
+    c->vfd = -1;
+}
+
+static int asked_slot(cam_t *c, int index)
+{
+    if (c->vfd < 0)
+        return -1;
+
+    struct v4l2_buffer b;
+    struct v4l2_plane  planes[VIDEO_MAX_PLANES];
+    memset(&b, 0, sizeof(b));
+    memset(planes, 0, sizeof(planes));
+    b.index = (unsigned)index;
+    b.type  = c->vtype;
+    if (c->vtype == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+        b.m.planes = planes;
+        b.length   = VIDEO_MAX_PLANES;
+    }
+
+    if (ioctl(c->vfd, VIDIOC_QUERYBUF, &b) < 0)
+        return -1;
+
+    int xfd = c->vtype == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE ? planes[0].m.fd : b.m.fd;
+
+    for (int s = 0; s < c->nslots; s++)
+        if (c->slot_xfd[s] == xfd)
+            return s;
+
+    return -1;
+}
